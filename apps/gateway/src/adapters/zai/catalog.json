					"parameters": {
						"thinking": {
							"mode": "supported",
							"upstreamField": "thinking",
							"values": ["enabled"],
							"notes": "GLM-5.3 always reasons; disabling thinking is not supported."
						},
						"reasoning_effort": {
							"mode": "mapped",
							"values": ["low", "high", "max"]
						},
