{
	"name": "@boelabs/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Bifrost documentation site (Next.js App Router, Fumadocs).",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"postinstall": "fumadocs-mdx",
		"dev": "bun scripts/dev.ts",
		"build": "next build && bun scripts/check-links.ts",
		"start": "bun scripts/start.ts",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "bun test tests"
	},
	"dependencies": {
		"fumadocs-core": "16.15.9",
		"fumadocs-mdx": "15.4.0",
		"fumadocs-ui": "16.15.9",
		"lucide-react": "1.45.0",
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwindcss": "4.3.3",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/node": "26.2.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"bun-types": "1.4.2",
		"typescript": "7.0.2"
	}
}
