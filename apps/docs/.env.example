# Bifrost documentation site. Nothing is required — the image runs with no configuration.

# Listen port. The image sets 3000; `bun run dev` reads DOCS_PORT first.
# PORT=3000
# DOCS_PORT=3000

# Public origin. Set it to publish /sitemap.xml; without it the site is identical, minus the sitemap.
# DOCS_SITE_URL=https://docs.example.com
