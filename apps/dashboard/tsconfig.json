{
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"next-env.d.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["bun-types"],
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"#/*": ["./src/*"]
		},
		"allowJs": true,
		"esModuleInterop": true,
		"incremental": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		/**
		 * The repo-wide config (packages/tsconfig) is deliberately not extended here. Its
		 * `exactOptionalPropertyTypes` and `noUncheckedIndexedAccess` fight React's own typings and
		 * third-party component props; relaxing them there would weaken the gateway's guarantees, which
		 * AGENTS.md forbids. Strict mode and unused-symbol checks still apply.
		 */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	}
}
