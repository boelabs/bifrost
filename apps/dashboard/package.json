{
	"name": "@boelabs/dashboard",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Bifrost operator dashboard (Next.js App Router, Base UI with BaseLayer styling).",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "next build",
		"start": "bun scripts/start.ts",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "bun test src/components/ui src/features src/shared",
		"api:types": "bunx openapi-typescript@7.13.0 ../gateway/openapi.yaml -o src/shared/api/schema.d.ts"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.53",
		"@ai-sdk/openai": "4.0.66",
		"@ai-sdk/openai-compatible": "3.0.48",
		"@ai-sdk/react": "4.0.102",
		"@base-ui/react": "1.8.0",
		"@streamdown/math": "1.0.2",
		"@tabler/icons-react": "3.46.0",
		"@tailwindcss/postcss": "4.3.3",
		"ai": "7.0.99",
		"cn": "0.3.0",
		"katex": "0.18.7",
		"motion": "13.2.0",
		"next": "16.3.5",
		"openapi-fetch": "0.17.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shiki": "4.4.3",
		"streamdown": "2.6.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"bun-types": "1.4.2",
		"@types/node": "26.2.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "7.0.2"
	}
}
