# Bifrost operator dashboard. Copy to .env.

# Where the gateway is — the only variable this app needs. On a private network use the service
# name (http://gateway:4000); the gateway needs no public domain of its own.
GATEWAY_URL=http://localhost:4000

# Listen port. The image sets 3001; `bun run dev` reads DASH_PORT first.
# PORT=3001
# DASH_PORT=3001
