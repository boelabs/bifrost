{
	"name": "bifrost",
	"version": "0.0.0",
	"description": "Bifrost by Boelabs — the gateway service, its docs site, and shared packages.",
	"license": "MIT",
	"author": "Boelabs",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.4"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"overrides": {
		"esbuild": "0.28.1",
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"protobufjs": "7.6.5",
		"sharp": "0.35.4",
		"zod": "4.6.2"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
		"test": "turbo run test",
		"test:all": "turbo run test:all",
		"audit": "bun scripts/audit-dependencies.ts",
		"lint": "biome lint .",
		"format": "biome format --write . && bun scripts/sort-imports.ts",
		"check": "biome check . --diagnostic-level=warn --error-on-warnings --max-diagnostics=100 && bun apps/gateway/scripts/check-adapter-transports.ts",
		"check:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@boelabs/tsconfig": "workspace:*",
		"@types/node": "26.5.1",
		"turbo": "2.10.12",
		"typescript": "7.0.2",
		"ultracite": "7.12.0"
	},
	"patchedDependencies": {
		"ai@7.0.99": "patches/ai@7.0.99.patch"
	}
}
