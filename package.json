{
	"name": "bifrost",
	"version": "0.1.0",
	"description": "Bifrost by Boelabs — the gateway service, its docs site, and shared packages.",
	"license": "MIT",
	"author": "Boelabs",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=24",
		"bun": ">=1.3"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"overrides": {
		"esbuild": "0.28.1",
		"js-yaml": "5.2.2",
		"nanoid": "3.3.17",
		"postcss": "8.5.25",
		"protobufjs": "7.6.5",
		"sharp": "0.35.3"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
		"test": "turbo run test",
		"test:all": "turbo run test:all",
		"audit": "bun scripts/audit-dependencies.ts",
		"lint": "biome lint .",
		"format": "biome format --write . && bun scripts/sort-imports.ts",
		"check": "biome check . --diagnostic-level=warn --error-on-warnings --max-diagnostics=100 && bun apps/gateway/scripts/check-adapter-transports.ts",
		"check:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@boelabs/tsconfig": "workspace:*",
		"@types/node": "26.1.2",
		"turbo": "2.10.8",
		"typescript": "7.0.2"
	}
}
