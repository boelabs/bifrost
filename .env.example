# Bifrost from published images. Copy to .env, fill in the four blanks, and:
#
#   docker compose -f compose.images.yaml up -d
#
# Every value is read when the container starts, so changing one is a restart, not a rebuild. The
# gateway has many more settings than these; they all ship with production-ready defaults and are
# documented in apps/gateway/.env.example.


# ============================================================== required

# Generate each one; never reuse an example.
#   MASTER_KEY         openssl rand -base64 48
#   ENCRYPTION_KEYRING openssl rand -hex 32
#   POSTGRES_PASSWORD  openssl rand -base64 24

# Root credential for the Admin API. At least 32 characters.
MASTER_KEY=

# Provider credentials are encrypted with this. Lose it and you lose them — back it up somewhere
# other than the database it protects.
ENCRYPTION_KEYRING={"k1":""}
ACTIVE_ENCRYPTION_KEY_ID=k1

POSTGRES_PASSWORD=


# ====================================================== operator dashboard

# The gateway serves the API with or without it. To run keys-only, set false and delete the
# dashboard service from the compose file.
DASH_ENABLED=true
DASH_ROOT_USER=admin

# At least 12 characters. Falls back to MASTER_KEY when empty; set it so the two rotate separately.
DASH_ROOT_PASSWORD=

# Where the dashboard finds the gateway. The browser never talks to the gateway itself, so this can
# stay on the private network and the gateway needs no public domain.
GATEWAY_URL=http://gateway:4000


# ================================================================ rollouts

# How a deployment replaces the gateway without dropping traffic. The container stays unready but
# keeps serving for DRAIN_DELAY_MS so the proxy can take it out of rotation, then lets in-flight
# requests finish for up to SHUTDOWN_TIMEOUT_MS. Raise the second one if you stream long responses,
# and raise `stop_grace_period` in the compose file to match.
# DRAIN_DELAY_MS=15000
# SHUTDOWN_TIMEOUT_MS=120000


# ================================================================== images

# Uncomment and pin to a release tag once you are in production; `latest` moves under you.
# GATEWAY_IMAGE=ghcr.io/boelabs/bifrost-gateway:v1.0.0
# DASHBOARD_IMAGE=ghcr.io/boelabs/bifrost-dashboard:v1.0.0
# DOCS_IMAGE=ghcr.io/boelabs/bifrost-docs:v1.0.0
